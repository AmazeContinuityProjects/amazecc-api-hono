# amazecc-api-hono — environment catalog
#
# Copy to .env (gitignored) for local development. NEVER commit secrets.
# Production: bindings/secrets live on wrangler (wrangler.jsonc + `wrangler secret put`),
# NOT here. This file documents what exists and what you must track/rotate.
#
# ── Account / zone (not secrets) ─────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=5abd6d7c8175ba56c3058e34db158aa8
CLOUDFLARE_ZONE=amazecc.com
CUSTOM_DOMAIN=hono.amazecc.com

# ── Bindings (declared in wrangler.jsonc; IDs are not secrets) ────────────────
# D1 "amazecc-auth" (SHARED with auth.amazecc.com — do not create your own)
AUTH_DB=8c4535b4-da9a-416e-8151-0d09db6ff9c6
# Hyperdrive → Supabase direct connection (pooler HANGS; use direct host)
HYPERDRIVE_ID=5dfc99cf90dc4fa0b438abe9801737b0
# Queue producer+consumer ("amazecc-sync", DLQ "amazecc-sync-dlq")
SYNC_QUEUE=amazecc-sync

# ── R2 / S3 storage for QBank papers (pick ONE) ──────────────────────────────
# Option A (preferred): native R2 binding. No keys needed — enable R2 in the
# Cloudflare Dashboard, create bucket "amazecc-qbank", add to wrangler.jsonc:
#   "r2_buckets": [{ "binding": "PAPERS_BUCKET", "bucket_name": "amazecc-qbank" }]
# Option B: S3-compatible creds (Backblaze B2 or AWS S3). Set all five:
B2_REGION=
B2_ENDPOINT=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET_NAME=

# ── Secrets (set with `wrangler secret put`, never commit values) ────────────
# HMAC signing root for service tokens (typ:"service", /api/services/* enrollment).
# Also the OLD admin-token root — legacy admin HMAC auth is REMOVED; do not reuse
# for that purpose. Keep stable for in-flight service tokens.
ADMIN_SECRET=
# Pseudonymous user hashing (ID_SALT) — used by mask/promoteHash.
ID_SALT=
# Comma-separated VTOP IDs seeded as admins historically (now unused for auth;
# honored never — Amaze ID role/permissions are authoritative).
ADMIN_VTOP_IDS=
# Web Push (VAPID) — broadcast notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Local-only ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ── Required for /api/remote/* (VTOP scrapers run here too; unrestricted IPs) ─
VTOP_BASE_URL=https://vtopcc.vit.ac.in

# ── Observability ─────────────────────────────────────────────────────────────
# Wrangler tail: pnpm exec wrangler tail amazecc-api-hono
