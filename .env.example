# ── Required ──────────────────────────────────────────────────────────────
# Admin HMAC secret (admin + club + service tokens). Long random string.
# Must NOT equal ID_SALT (checked at startup? by the caller of admin auth).
ADMIN_SECRET=

# Student-identity pseudonym salt (HMAC of register numbers → owner_key).
ID_SALT=

# ── Database (pick ONE) ────────────────────────────────────────────────────
# Production: bind Hyperdrive in wrangler.jsonc (`wrangler hyperdrive create …`).
# No DATABASE_URL needed in production.
# Local dev only: direct connection (e.g. Supabase pooler / local Postgres):
DATABASE_URL=postgresql://user:pass@localhost:5432/amazecc
# Optional: cap the local pool (default 5)
PG_POOL_MAX=5

# ── Environment (optional) ─────────────────────────────────────────────────
# VTOP base URL (defaults to https://vtopcc.vit.ac.in)
VTOP_BASE_URL=
# Header your edge sets with the real client IP (e.g. cf-connecting-ip)
TRUSTED_IP_HEADER=cf-connecting-ip
# Comma-separated VTOP ids that are always superadmins (skips DB grant check)
ADMIN_VTOP_IDS=
# Postgres CA cert (PEM) — only used by the Deno/Node fallback, not Workers
# PG_CA_CERT=

# ── Web push (admin broadcast) ─────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Backblaze B2 / S3-compatible storage (qbank admin; qbank itself is NEXT pass)
# B2_REGION=
# B2_ENDPOINT=
# B2_ACCESS_KEY_ID=
# B2_SECRET_ACCESS_KEY=
# B2_BUCKET_NAME=

# ── Background jobs ────────────────────────────────────────────────────────
# CRON_SECRET=            # only for the future /api/cron/* port (reminders)
